#-----------------------------------------------------------------------
# Application
#-----------------------------------------------------------------------
APP_NAME="Diet Watchers"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

#-----------------------------------------------------------------------
# Security
#-----------------------------------------------------------------------
BCRYPT_ROUNDS=12

#-----------------------------------------------------------------------
# Logging
#-----------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-----------------------------------------------------------------------
# Database
#-----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dietwatcher
DB_USERNAME=root
DB_PASSWORD=

#-----------------------------------------------------------------------
# External API (Diet Watchers Backend)
#-----------------------------------------------------------------------
EXTERNAL_API_URL=
EXTERNAL_API_TOKEN=
# Optional fallback branch_id used for external POST /orders sync
# when checkout payload has no branch_id (usually home delivery flow).
EXTERNAL_API_DEFAULT_ORDER_BRANCH_ID=
# When true, checkout phone OTP uses the external app API (EXTERNAL_API_URL) and stores the returned token for addresses/payment. Set false to use local SMS OTP only.
CHECKOUT_USE_EXTERNAL_LOGIN=true
# When true, enables the new multi-step OTP + register modal on checkout.
# When false (default), uses the legacy single-step OTP modal.
CHECKOUT_USE_NEW_AUTH_FLOW=false

#-----------------------------------------------------------------------
# Session
#-----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# Set true on HTTPS production (e.g. app.diet-watchers.sa). Leave empty to auto-detect.
SESSION_SECURE_COOKIE=
# For app.diet-watchers.sa use .diet-watchers.sa or leave empty; wrong domain breaks cart/session.
# SESSION_DOMAIN=.diet-watchers.sa
# Catalog (/programs, /meals) is fetched without Authorization. Do not put an expired customer
# token in EXTERNAL_API_TOKEN for catalog-only — it breaks /meals via auth.optional (401).
# Use a valid app/service token only if your API requires it for non-meal endpoints.

#-----------------------------------------------------------------------
# Drivers
#-----------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

#-----------------------------------------------------------------------
# Redis (optional — used if CACHE_STORE=redis or QUEUE_CONNECTION=redis)
#-----------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#-----------------------------------------------------------------------
# Mail
#-----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dietwatchers.com"
MAIL_FROM_NAME="${APP_NAME}"

#-----------------------------------------------------------------------
# Payment Gateway (Moyasar)
# https://moyasar.com — Get keys from dashboard
# MOYASAR_PUBLISHABLE_KEY must start with pk_test_ or pk_live_
# MOYASAR_SECRET_KEY must start with sk_test_ or sk_live_ (never swap these)
#-----------------------------------------------------------------------
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Must match MOYASAR_SECRET_TOKEN on the external API (webhook/payment auth).
MOYASAR_SECRET_TOKEN=

#-----------------------------------------------------------------------
# SMS Provider (connect | mshastra)
# Used for OTP verification during checkout
#-----------------------------------------------------------------------
SMS_PROVIDER=connect

# Connect Saudi (default)
CONNECT_URL=https://sms.connectsaudi.com/sendurl.aspx
CONNECT_PROFILE_ID=
CONNECT_PASSWORD=
CONNECT_SENDER_ID=DietWatcher

# Mshastra (alternative)
MSHASTRA_URL=https://mshastra.com/sendurl.aspx
MSHASTRA_PROFILE_ID=
MSHASTRA_PASSWORD=
MSHASTRA_SENDER_ID=

#-----------------------------------------------------------------------
# AWS (optional — only if using S3 filesystem)
#-----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#-----------------------------------------------------------------------
# Vite
#-----------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

#-----------------------------------------------------------------------
# Google Maps (for address picker on checkout)
#-----------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

#-----------------------------------------------------------------------
# Google Gemini (AI Meal Assistant — free tier gemini-2.0-flash)
# https://aistudio.google.com/apikey
#-----------------------------------------------------------------------
GEMINI_API_KEY=

#-----------------------------------------------------------------------
# AI Blog Generation (daily via scheduler — php artisan blog:generate-daily)
#-----------------------------------------------------------------------
BLOG_DAILY_GENERATION=true
BLOG_DAILY_TIME=08:00
